{
  "testEnvironment": "node",
  "rootDir": "..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["ts", "js", "json"],

  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "test/tsconfig.e2e.json"
      }
    ]
  },

  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}