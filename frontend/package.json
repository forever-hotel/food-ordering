{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "test:e2e:mock": "playwright test --project=default",
    "test:e2e:api": "NEXT_PUBLIC_DATA_MODE=api playwright test --project=default",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.5",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
