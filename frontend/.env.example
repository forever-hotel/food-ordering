PORT=3000

# Backend Routing Configurations:
# Option 1: Direct local backend (when running without api-gateway)
NEXT_PUBLIC_API_URL=http://localhost:4300

# Option 2: API Gateway integration (standard hotel deployment via gateway proxy)
# NEXT_PUBLIC_API_URL=http://localhost:8080/foss
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Data Mode Configuration:
# - 'api':  Real HTTP API requests to the NestJS backend (Live API mode, default)
# - 'demo': Client-side in-memory mock fixtures without backend dependency (Mock Demo mode)
NEXT_PUBLIC_DATA_MODE=api

# Deployment Environment Tier (development | preview | staging | production)
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Order status demo simulation (development only, disabled by default and strictly blocked in production/staging)
NEXT_PUBLIC_ENABLE_ORDER_DEMO_SIMULATION=false
